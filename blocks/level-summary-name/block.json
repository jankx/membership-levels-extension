{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/level-summary-name",
    "title": "Level Summary Name",
    "category": "jankx",
    "icon": "heading",
    "description": "Name of the account level, e.g. the tier title.",
    "textdomain": "jankx",
    "parent": ["jankx/account-level-summary"],
    "editorScript": "file:./build/index.tsx.js",
    "attributes": {
        "text": { "type": "string", "default": "" },
        "tagName": { "type": "string", "default": "h3" },
        "fontSize": { "type": "number", "default": 17 },
        "useLevelColor": { "type": "boolean", "default": true },
        "jankxHideOnUltrawide": { "type": "boolean", "default": false },
        "jankxHideOnPc": { "type": "boolean", "default": false },
        "jankxHideOnTablet": { "type": "boolean", "default": false },
        "jankxHideOnMobile": { "type": "boolean", "default": false }
    },
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "typography": {
            "fontSize": true,
            "fontWeight": true,
            "lineHeight": true
        }
    }
}