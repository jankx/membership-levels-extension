{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/level-summary-icon",
    "title": "Level Summary Icon",
    "category": "jankx",
    "icon": "awards",
    "description": "Badge icon of the account level summary. Drop an SVG Icon / Icon Picker / Advanced Image inside to override the default level artwork.",
    "textdomain": "jankx",
    "parent": ["jankx/account-level-summary"],
    "editorScript": "file:./build/index.tsx.js",
    "attributes": {
        "iconName": { "type": "string", "default": "" },
        "size": { "type": "number", "default": 48 },
        "iconSize": { "type": "number", "default": 22 },
        "borderWidth": { "type": "number", "default": 2 },
        "backgroundColor": { "type": "string", "default": "#ffffff" },
        "useLevelColor": { "type": "boolean", "default": true },
        "jankxHideOnUltrawide": { "type": "boolean", "default": false },
        "jankxHideOnPc": { "type": "boolean", "default": false },
        "jankxHideOnTablet": { "type": "boolean", "default": false },
        "jankxHideOnMobile": { "type": "boolean", "default": false }
    },
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    }
}