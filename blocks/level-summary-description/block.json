{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/level-summary-description",
    "title": "Level Summary Description",
    "category": "jankx",
    "icon": "text",
    "description": "Description of the account level, plus an optional detail link.",
    "textdomain": "jankx",
    "parent": [
        "jankx/account-level-summary"
    ],
    "editorScript": "file:./build/index.tsx.js",
    "attributes": {
        "text": {
            "type": "string",
            "default": ""
        },
        "fontSize": {
            "type": "number",
            "default": 13
        },
        "linkText": {
            "type": "string",
            "default": "Xem chi tiết"
        },
        "showLink": {
            "type": "boolean",
            "default": true
        },
        "detailUrl": {
            "type": "string",
            "default": ""
        },
        "linkTarget": {
            "type": "string",
            "default": "_self"
        },
        "jankxHideOnUltrawide": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnPc": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnTablet": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnMobile": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        }
    }
}
