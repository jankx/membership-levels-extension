{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/account-level-summary",
    "title": "Account Level Summary",
    "category": "jankx",
    "icon": "star-filled",
    "description": "Membership level summary card for the account sidebar. Drag Icon / Name / Description blocks inside to customise each part.",
    "textdomain": "jankx",
    "editorScript": "file:./build/index.tsx.js",
    "parent": [
        "jankx/account-sidebar"
    ],
    "attributes": {
        "showIcon": {
            "type": "boolean",
            "default": true
        },
        "showName": {
            "type": "boolean",
            "default": true
        },
        "showDescription": {
            "type": "boolean",
            "default": true
        },
        "detailUrl": {
            "type": "string",
            "default": ""
        },
        "jankxHideOnUltrawide": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnPc": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnTablet": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnMobile": {
            "type": "boolean",
            "default": false
        },
        "jankxFlexGrow": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": true,
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    },
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
